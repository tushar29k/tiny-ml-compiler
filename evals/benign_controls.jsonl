{"id": "scalar-broadcast-mix", "family": "control", "goal": "none", "description": "0-d scalar const times a (3,) input plus a (3,) const", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "s", "op": "const", "value": 2.0}, {"ref": "w", "op": "const", "value": [1.0, 2.0, 3.0]}, {"ref": "m", "op": "mul", "inputs": ["x", "s"]}, {"ref": "a", "op": "add", "inputs": ["m", "w"]}], "outputs": ["a"]}, "feed": {"x": [1.0, 2.0, 3.0]}}
{"id": "zero-size-matmul", "family": "control", "goal": "none", "description": "zero-size dimensions: (0,3) @ (3,2) -> (0,2), then relu", "graph": {"nodes": [{"ref": "a", "op": "const", "value": {"shape": [0, 3], "fill": 0.0}}, {"ref": "b", "op": "const", "value": {"shape": [3, 2], "fill": 1.0}}, {"ref": "m", "op": "matmul", "inputs": ["a", "b"]}, {"ref": "r", "op": "relu", "inputs": ["m"]}], "outputs": ["m", "r"]}, "feed": {}}
{"id": "shared-mul-two-consumers", "family": "control", "goal": "none", "description": "one mul feeding both an add and a relu; fusion must leave it alone and both outputs must stay correct", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "w", "op": "const", "value": [2.0]}, {"ref": "m", "op": "mul", "inputs": ["x", "w"]}, {"ref": "a", "op": "add", "inputs": ["m", "w"]}, {"ref": "r", "op": "relu", "inputs": ["m"]}], "outputs": ["a", "r"]}, "feed": {"x": [3.0]}}
{"id": "mul-output-and-fused", "family": "control", "goal": "none", "description": "the mul is itself a graph output AND is fused into the add; both outputs must survive optimisation with correct values", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "w", "op": "const", "value": [2.0]}, {"ref": "b", "op": "const", "value": [1.0]}, {"ref": "m", "op": "mul", "inputs": ["x", "w"]}, {"ref": "a", "op": "add", "inputs": ["m", "b"]}], "outputs": ["m", "a"]}, "feed": {"x": [4.0]}}
{"id": "hand-written-fused", "family": "control", "goal": "none", "description": "fused_mul_add written by hand with the correct three operands (the README says only the fusion pass produces it, but the builder accepts it)", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "w", "op": "const", "value": [3.0]}, {"ref": "b", "op": "const", "value": [1.0]}, {"ref": "f", "op": "fused_mul_add", "inputs": ["x", "w", "b"]}], "outputs": ["f"]}, "feed": {"x": [2.0]}}
{"id": "all-const-folds-to-one", "family": "control", "goal": "none", "description": "a const-only graph folds to a single node; the generated function then has no compute lines at all", "graph": {"nodes": [{"ref": "a", "op": "const", "value": [[1.0, 2.0], [3.0, 4.0]]}, {"ref": "b", "op": "const", "value": [[5.0, 6.0], [7.0, 8.0]]}, {"ref": "m", "op": "matmul", "inputs": ["a", "b"]}, {"ref": "r", "op": "relu", "inputs": ["m"]}], "outputs": ["r"]}, "feed": {}}
{"id": "dead-branch-unused-input", "family": "control", "goal": "none", "description": "an unused input and a dead mul branch; DCE must prune the branch and keep the live output correct", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "y", "op": "input", "name": "y"}, {"ref": "c", "op": "const", "value": [2.0]}, {"ref": "dead", "op": "mul", "inputs": ["x", "c"]}, {"ref": "live", "op": "relu", "inputs": ["x"]}], "outputs": ["live"]}, "feed": {"x": [-1.0], "y": [9.0]}}
{"id": "unicode-input-name", "family": "control", "goal": "none", "description": "an input name with a space and a non-ASCII character; codegen quotes names with repr, so this must just work", "graph": {"nodes": [{"ref": "u", "op": "input", "name": "café input"}, {"ref": "c", "op": "const", "value": [1.0]}, {"ref": "a", "op": "add", "inputs": ["u", "c"]}], "outputs": ["a"]}, "feed": {"café input": [5.0]}}
{"id": "duplicate-output-listing", "family": "control", "goal": "none", "description": "the same node listed twice as an output; both the interpreter and the generated dict collapse it to one key", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "c", "op": "const", "value": [1.0]}, {"ref": "a", "op": "add", "inputs": ["x", "c"]}], "outputs": ["a", "a"]}, "feed": {"x": [1.0]}}
{"id": "broadcast-shapes", "family": "control", "goal": "none", "description": "(3,1) + (1,4) broadcasting to (3,4), then relu over negatives", "graph": {"nodes": [{"ref": "a", "op": "const", "value": [[1.0], [-2.0], [3.0]]}, {"ref": "b", "op": "const", "value": [[10.0, -20.0, 30.0, -40.0]]}, {"ref": "s", "op": "add", "inputs": ["a", "b"]}, {"ref": "r", "op": "relu", "inputs": ["s"]}], "outputs": ["r"]}, "feed": {}}
{"id": "chain-and-fanout", "family": "control", "goal": "none", "description": "a 100-relu chain whose result fans out into two muls and an add", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}, {"ref": "mid", "chain": {"op": "relu", "times": 100, "from": "x"}}, {"ref": "k1", "op": "const", "value": [1.0]}, {"ref": "k2", "op": "const", "value": [2.0]}, {"ref": "p1", "op": "mul", "inputs": ["mid", "k1"]}, {"ref": "p2", "op": "mul", "inputs": ["mid", "k2"]}, {"ref": "s", "op": "add", "inputs": ["p1", "p2"]}], "outputs": ["s"]}, "feed": {"x": [-3.0, 5.0]}}
{"id": "const-passthrough", "family": "control", "goal": "none", "description": "a graph whose only node is a constant, listed directly as the output", "graph": {"nodes": [{"ref": "c", "op": "const", "value": [4.0, 5.0]}], "outputs": ["c"]}, "feed": {}}
{"id": "input-passthrough", "family": "control", "goal": "none", "description": "a graph whose only node is an input, listed directly as the output", "graph": {"nodes": [{"ref": "x", "op": "input", "name": "x"}], "outputs": ["x"]}, "feed": {"x": [7.0]}}
